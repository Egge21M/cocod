{
  "name": "cocod-daemon-api",
  "version": "0.0.16",
  "transport": {
    "protocol": "http",
    "unixSocketEnv": "COCOD_SOCKET",
    "defaultUnixSocket": "~/.cocod/cocod.sock",
    "notes": "COCOD_DIR relocates the whole state directory (config, database, socket, pid, log); COCOD_SOCKET overrides the socket path alone."
  },
  "responseContract": {
    "success": {
      "shape": {
        "output": "unknown"
      }
    },
    "error": {
      "shape": {
        "error": "string"
      }
    }
  },
  "endpoints": [
    {
      "path": "/ping",
      "method": "GET",
      "state": "any",
      "responses": {
        "200": "{ output: \"pong\" }"
      }
    },
    {
      "path": "/status",
      "method": "GET",
      "state": "any",
      "responses": {
        "200": "{ output: \"UNINITIALIZED\" | \"LOCKED\" | \"UNLOCKED\" | \"ERROR\" }"
      }
    },
    {
      "path": "/init",
      "method": "POST",
      "state": "UNINITIALIZED",
      "body": {
        "mnemonic": "string (optional)",
        "passphrase": "string (optional)",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: \"Invalid mnemonic\" }",
        "409": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/unlock",
      "method": "POST",
      "state": "LOCKED",
      "body": {
        "passphrase": "string"
      },
      "responses": {
        "200": "{ output: \"Unlocked\" }",
        "400": "{ error: string }",
        "401": "{ error: string }",
        "409": "{ error: string }",
        "503": "{ error: string }"
      }
    },
    {
      "path": "/balance",
      "method": "GET",
      "state": "UNLOCKED",
      "notes": "sats is the total balance (spendable + reserved), matching pre-v2 semantics; sat unit only.",
      "responses": {
        "200": "{ output: Record<string, { sats: number }> }",
        "403": "{ error: string }",
        "503": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/cashu",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "token": "string"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/bolt11",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/onchain",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number (optional)",
        "mintUrl": "string (optional)"
      },
      "notes": "Returns a non-expiring mint deposit address (NUT-30). With amount, output is a BIP-321 address-and-amount URI; testnet SegWit uses the tb query key. The amount is a payment hint and only eligible confirmed deposits are mintable. Supplied amounts are checked against the mint range because Coco rc.2 auto-claims the available balance as one operation. Returns 503 for every non-null expiry.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "503": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/bolt12",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number (optional)",
        "description": "string (optional)",
        "mintUrl": "string (optional)"
      },
      "notes": "Returns a BOLT12 offer (lno1...) from a NUT-25 mint quote. Amountless offers are reusable. Returns 503 for expiry-zero quotes that the pinned Coco rc.2 core cannot safely monitor.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "503": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/cashu",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/bolt11",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "invoice": "string",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/onchain",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "address": "string",
        "amount": "number",
        "feeIndex": "number (optional, defaults to cheapest fee option)",
        "mintUrl": "string (optional)"
      },
      "notes": "NUT-30 onchain melt. address must be a raw Bitcoin address and amount is required in sats; send-side BIP-321 parsing is outside this API's scope. A pending operation returns 202 with its operation ID; a finalized operation returns 200.",
      "responses": {
        "200": "{ output: string }",
        "202": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/bolt12",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "offer": "string",
        "amount": "number (optional, required for amountless offers)",
        "mintUrl": "string (optional)"
      },
      "notes": "NUT-25 bolt12 melt. For amountless offers the mint rejects the quote unless amount is provided.",
      "responses": {
        "200": "{ output: string }",
        "202": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/x-cashu/parse",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "request": "string"
      },
      "notes": "Supports creqA requests without NUT-10 locks. Rejects creqB before decoding because the pinned Cashu dependency can discard its locking condition.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/x-cashu/handle",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "request": "string",
        "mintUrl": "string (optional)"
      },
      "notes": "Supports creqA requests without NUT-10 locks. Rejects creqB and decoded NUT-10 locks before preparing proofs.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/add",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "url": "string"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/list",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/default",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "url": "string"
      },
      "notes": "Trusts the mint, persists it as the default in config.json, and updates the running daemon immediately.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/info",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "url": "string"
      },
      "responses": {
        "200": "{ output: unknown }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/history",
      "method": "GET",
      "state": "UNLOCKED",
      "query": {
        "offset": "number (optional, default 0)",
        "limit": "number (optional, default 20, max 100)"
      },
      "notes": "coco v2 history entries: amounts are converted to JSON numbers, rolled-back state is 'rolled_back', ids derive from operation ids (legacy rows keep 'legacy:' ids). The token field is stripped from the output so proof secrets never reach stdout.",
      "responses": {
        "200": "{ output: unknown[] }",
        "400": "{ error: string }"
      }
    },
    {
      "path": "/events",
      "method": "GET",
      "state": "UNLOCKED",
      "notes": "Streams history:updated events. Entries are sanitized like /history (token stripped).",
      "responses": {
        "200": "text/event-stream"
      }
    },
    {
      "path": "/npc/address",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/npc/username",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "username": "string",
        "confirm": "boolean (optional)"
      },
      "responses": {
        "200": "{ output: unknown }",
        "400": "{ error: string }",
        "402": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/stop",
      "method": "POST",
      "state": "any",
      "responses": {
        "200": "{ output: \"Daemon stopping\" }"
      }
    }
  ]
}
